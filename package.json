{
  "name": "bhh-chemotherapy-calculator-v2",
  "version": "3.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/production-smoke.mjs && node tests/runtime-startup-static.mjs",
    "smoke": "node tests/production-smoke.mjs",
    "serve": "python3 -m http.server 8080",
    "build:v3": "node v3/scripts/build.mjs",
    "import:v3": "node v3/scripts/import.mjs",
    "test:v3": "node --test v3/tests/*.test.mjs",
    "test:api:v3": "node v3/tests/run-local.mjs api",
    "test:browser:v3": "node v3/tests/run-local.mjs browser",
    "dev:v3": "wrangler dev --config v3/wrangler.jsonc --env local",
    "setup:local:v3": "wrangler d1 migrations apply DB --config v3/wrangler.jsonc --env local --local && wrangler d1 execute DB --config v3/wrangler.jsonc --env local --local --file v3/scripts/local-users.sql",
    "check:deploy:v3": "node v3/scripts/check-deploy.mjs staging",
    "deploy:staging:v3": "npm run build:v3 && node v3/scripts/check-deploy.mjs staging && wrangler deploy --config v3/wrangler.jsonc --env staging",
    "test:staging:v3": "node v3/tests/run-staging-local.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sparticuz/chromium": "^153.0.0",
    "prettier": "^3.9.9",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "jose": "^6.2.12"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
