{
  "name": "bhh-chemotherapy-v3",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_ENV": "production",
    "ACCESS_TEAM_DOMAIN": "REPLACE.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bhh-chemo-production",
      "database_id": "REPLACE_PRODUCTION_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "bhh-chemotherapy-v3-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "AUTH_MODE": "internal",
        "PUBLIC_CALCULATOR": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bhh-chemo-staging",
          "database_id": "3d936db6-eed1-4880-9561-1f22101cb27e",
          "migrations_dir": "migrations"
        }
      ]
    },
    "local": {
      "name": "bhh-chemotherapy-v3-local",
      "vars": {
        "APP_ENV": "local",
        "LOCAL_TEST_AUTH": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bhh-chemo-local",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}
